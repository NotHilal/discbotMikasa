[Unit]
Description=Mikasa Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikasa
WorkingDirectory=/opt/mikasa
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mikasa/venv/bin/python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
